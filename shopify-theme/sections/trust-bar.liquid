<section class="thread" data-tone="light">
  <div class="thread__in">
    {%- for block in section.blocks -%}
      <span class="label">{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Hilo de confianza",
  "blocks": [
    { "type": "item", "name": "Texto", "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Envíos a todo Colombia" }] }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "Envíos a todo Colombia" } },
      { "type": "item", "settings": { "text": "Pago seguro" } },
      { "type": "item", "settings": { "text": "Selección curada" } },
      { "type": "item", "settings": { "text": "Asesoría personal" } }
    ]
  },
  "presets": [{ "name": "Hilo de confianza" }]
}
{% endschema %}
