<section class="hero grain" data-hero data-tone="dark">
  <div class="hero__texture" data-depth="-6"></div>
  <div class="hero__pool" data-depth="10"></div>
  <div class="hero__wordmark" aria-hidden="true"><img src="{{ 'velmont-letters-ivory.webp' | asset_url }}" alt="" width="1550" height="195"></div>

  <div class="hero__stage" data-hero-stage data-depth="24">
    <div data-hero-bottle></div>
    <div class="hero__reflect" data-hero-reflect aria-hidden="true"></div>
  </div>
  <div class="hero__sweep" aria-hidden="true"></div>

  <div class="hero__copy">
    <span class="label hero__kicker" data-reveal>{{ section.settings.kicker }}</span>
    <h1 class="display hero__title">
      <span class="line-mask" data-reveal><span>{{ section.settings.line_one }}</span></span>
      <span class="line-mask" data-reveal style="--reveal-delay:120ms"><span><em>{{ section.settings.line_two }}</em></span></span>
    </h1>
    <div class="hero__actions" data-reveal style="--reveal-delay:320ms">
      {%- if section.settings.cta_one != blank -%}
        <a href="{{ section.settings.cta_one_url | default: routes.all_products_collection_url }}" class="act">{{ section.settings.cta_one }}</a>
      {%- endif -%}
      {%- if section.settings.cta_two != blank -%}
        <button class="act" data-finder-open>{{ section.settings.cta_two }}</button>
      {%- endif -%}
    </div>
  </div>

  <div class="hero__meta">
    <span class="label">{{ section.settings.meta_one }}</span>
    <span class="label">{{ section.settings.meta_two }}</span>
  </div>
  <div class="hero__scroll"><span class="label">{{ section.settings.scroll_label }}</span><i></i></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Colección 001" },
    { "type": "text", "id": "line_one", "label": "Titular línea 1", "default": "Una fragancia." },
    { "type": "text", "id": "line_two", "label": "Titular línea 2 (cursiva)", "default": "Una firma." },
    { "type": "text", "id": "cta_one", "label": "Botón 1", "default": "Ver la colección" },
    { "type": "url", "id": "cta_one_url", "label": "Enlace botón 1" },
    { "type": "text", "id": "cta_two", "label": "Botón 2 (abre el finder)", "default": "Descubre tu firma" },
    { "type": "text", "id": "meta_one", "label": "Meta izquierda", "default": "Bogotá · Colombia" },
    { "type": "text", "id": "meta_two", "label": "Meta derecha", "default": "Envíos a todo el país" },
    { "type": "text", "id": "scroll_label", "label": "Indicador de scroll", "default": "Desliza" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
