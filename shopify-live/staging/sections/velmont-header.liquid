<header class="site-header" data-site-header>
  <div class="page-width site-header__inner">
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="VelmontNav" data-nav-toggle>
      <span></span><span></span><span></span><span class="visually-hidden">Abrir menú</span>
    </button>
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — Inicio">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 500 | image_tag: widths: '180, 300, 500', alt: shop.name }}
      {% else %}
        <img src="{{ 'velmont-logo-header.png' | asset_url }}" width="249" height="198" alt="Velmont Fragrances">
      {% endif %}
    </a>
    <nav id="VelmontNav" class="site-nav" aria-label="Navegación principal" data-site-nav>
  {% if section.settings.menu != blank %}

    {% for link in section.settings.menu.links %}

      {% if link.links != blank %}

        <div class="velmont-nav-dropdown">
          <button
            type="button"
            class="velmont-nav-dropdown__toggle"
            aria-expanded="false"
          >
            {{ link.title }}
            <span class="velmont-nav-dropdown__arrow">⌄</span>
          </button>

          <div class="velmont-nav-dropdown__menu">
            {% for child_link in link.links %}
              <a href="{{ child_link.url }}" class="velmont-nav-dropdown__item">
                {{ child_link.title }}
              </a>
            {% endfor %}
          </div>
        </div>

      {% else %}

        <a href="{{ link.url }}">{{ link.title }}</a>

      {% endif %}

    {% endfor %}

  {% else %}

    <a href="{{ routes.all_products_collection_url }}">Catálogo</a>
    <a href="{{ collections['para-ella'].url | default: '/collections/para-ella' }}">Para ella</a>
    <a href="{{ collections['para-el'].url | default: '/collections/para-el' }}">Para él</a>
    <a href="{{ collections['unisex'].url | default: '/collections/unisex' }}">Unisex</a>
    <a href="{{ routes.root_url }}#ediciones-velmont">Ofertas</a>

  {% endif %}
</nav>
    <div class="header-actions">
      <button class="header-icon" type="button" data-search-open aria-label="Buscar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button class="header-icon" type="button" data-saved-open aria-label="Ver guardados">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 20s-7-4.4-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.6-9.5 9-9.5 9Z"/></svg>
        <span class="header-icon__count" data-saved-count hidden>0</span>
      </button>
      <a class="header-cart" href="{{ routes.cart_url }}" data-cart-open aria-label="Ver bolsa, {{ cart.item_count }} artículos">
        <span class="header-cart__word">Bolsa</span><span class="header-cart__count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
<style>
  .velmont-nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

 .velmont-nav-dropdown__toggle {
  background: none;
  border: 0;
  padding: 0;
  margin: 0;
  color: rgba(255,255,255,0.88);
  font-family: inherit;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.12em;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  text-transform: uppercase;
}
.site-nav > a {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.88);
}

.site-nav > a:hover,
.velmont-nav-dropdown__toggle:hover {
  color: #d4b256;
}
 .velmont-nav-dropdown__arrow {
  font-size: 9px;
  font-weight: 400;
  line-height: 1;
}

  .velmont-nav-dropdown__menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    background: #0a0a0a;
    border: 1px solid rgba(212, 178, 86, 0.45);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    padding: 8px 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 9999;
  }

  .velmont-nav-dropdown:hover .velmont-nav-dropdown__menu,
  .velmont-nav-dropdown:focus-within .velmont-nav-dropdown__menu,
  .velmont-nav-dropdown.is-open .velmont-nav-dropdown__menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .velmont-nav-dropdown:hover .velmont-nav-dropdown__arrow,
  .velmont-nav-dropdown.is-open .velmont-nav-dropdown__arrow {
    transform: rotate(180deg);
  }

  .velmont-nav-dropdown__item {
    display: block;
    padding: 13px 18px;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.08em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .velmont-nav-dropdown__item:hover {
    background: rgba(212, 178, 86, 0.12);
    color: #d4b256;
  }

  @media (max-width: 749px) {
    .velmont-nav-dropdown {
      width: 100%;
      display: block;
    }

    .velmont-nav-dropdown__toggle {
      width: 100%;
      justify-content: space-between;
    }

    .velmont-nav-dropdown__menu {
      position: static;
      transform: none;
      min-width: 0;
      width: 100%;
      margin-top: 10px;
      display: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .velmont-nav-dropdown.is-open .velmont-nav-dropdown__menu {
      display: block;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.velmont-nav-dropdown__toggle').forEach(function (toggle) {
      toggle.addEventListener('click', function (event) {
        event.preventDefault();

        const dropdown = toggle.closest('.velmont-nav-dropdown');
        const isOpen = dropdown.classList.contains('is-open');

        document.querySelectorAll('.velmont-nav-dropdown.is-open').forEach(function (item) {
          item.classList.remove('is-open');
          const button = item.querySelector('.velmont-nav-dropdown__toggle');
          if (button) button.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          dropdown.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('.velmont-nav-dropdown')) {
        document.querySelectorAll('.velmont-nav-dropdown.is-open').forEach(function (item) {
          item.classList.remove('is-open');
          const button = item.querySelector('.velmont-nav-dropdown__toggle');
          if (button) button.setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>
{% schema %}
{
  "name": "Encabezado Velmont",
  "settings": [
    {"type":"link_list","id":"menu","label":"Menú principal"}
  ]
}
{% endschema %}
