<header class="site-header" data-header>
  <div class="container site-header__inner">
    <nav class="site-header__nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="link-underline">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <a href="{{ routes.root_url }}" class="site-header__logo">
      <img src="{{ 'velmont-wordmark.png' | asset_url }}" alt="{{ shop.name }}" width="240" height="53" loading="eager">
    </a>
    <div class="site-header__actions">
      <button class="icon-btn" data-search-open aria-label="Buscar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button class="icon-btn" data-favorites-open aria-label="Favoritos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.4-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.6-9.5 9-9.5 9Z"/></svg>
        <span class="cart-badge is-hidden" data-favorites-count>0</span>
      </button>
      <button class="icon-btn" data-cart-open aria-label="Carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 4.5 2H2"/><circle cx="9.5" cy="20" r="1.4" fill="currentColor" stroke="none"/><circle cx="17" cy="20" r="1.4" fill="currentColor" stroke="none"/></svg>
        <span class="cart-badge is-hidden" data-cart-count>{{ cart.item_count }}</span>
      </button>
      <button class="icon-btn nav-toggle" data-nav-toggle aria-label="Abrir menú" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
