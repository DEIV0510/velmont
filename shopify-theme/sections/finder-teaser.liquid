<section class="band finder-gate grain" data-tone="dark" id="descubre">
  <div class="finder-gate__in">
    <span class="section-index" data-reveal>{{ section.settings.index_label }}</span>
    <h2 class="display" data-reveal style="max-width:14ch">
      <span class="line-mask"><span>{{ section.settings.line_one }}</span></span>
      <span class="line-mask" style="--reveal-delay:100ms"><span><em>{{ section.settings.line_two }}</em></span></span>
    </h2>
    <p class="lede" data-reveal style="--reveal-delay:220ms">{{ section.settings.body }}</p>
    <button class="act" data-finder-open data-reveal style="--reveal-delay:320ms">{{ section.settings.cta }}</button>
  </div>
</section>

{% schema %}
{
  "name": "Descubre tu firma",
  "settings": [
    { "type": "text", "id": "index_label", "label": "Índice", "default": "03 — Descubre" },
    { "type": "text", "id": "line_one", "label": "Línea 1", "default": "¿Qué define" },
    { "type": "text", "id": "line_two", "label": "Línea 2 (cursiva)", "default": "tu presencia?" },
    { "type": "textarea", "id": "body", "label": "Párrafo", "default": "Cuatro preguntas. Una firma olfativa. Sin catálogos infinitos ni filtros que no dicen nada." },
    { "type": "text", "id": "cta", "label": "Botón", "default": "Comenzar" }
  ],
  "presets": [{ "name": "Descubre tu firma" }]
}
{% endschema %}
