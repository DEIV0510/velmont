{%- comment -%}
  Iconos de linea, 1.3 de grosor, heredan currentColor. Un solo sitio para
  todos: si cambia el grosor, cambia en toda la tienda.
  Uso: {% render 'icon', name: 'bag', size: 17 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 17
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
  {%- when 'heart' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="{% if filled %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.6-9.5 9-9.5 9Z"/></svg>
  {%- when 'bag' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M6 7h12l1 14H5z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
  {%- when 'close' -%}
    <svg width="{{ s | plus: 1 }}" height="{{ s | plus: 1 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'arrow' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M4 12h15m-5-6 6 6-6 6"/></svg>
  {%- when 'chat' -%}
    <svg width="{{ s | plus: 3 }}" height="{{ s | plus: 3 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5Z"/></svg>
{%- endcase -%}
