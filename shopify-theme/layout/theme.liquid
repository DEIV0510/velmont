<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:title" content="{{ page_title | escape }}">
{% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:url" content="{{ canonical_url }}">

<link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32">
<link rel="icon" href="{{ 'favicon-192.png' | asset_url }}" sizes="192x192">
<link rel="apple-touch-icon" href="{{ 'favicon-180.png' | asset_url }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="preload" as="image" href="{{ 'velmont-logo-full@2x.png' | asset_url }}">
<link rel="stylesheet" href="{{ 'tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'components.css' | asset_url }}">

{{ content_for_header }}
</head>
<body{% unless template.name == 'index' %} data-hdr="light" style="background:var(--ivory)"{% endunless %}>

<div data-loading-screen>
  <div style="text-align:center">
    <img class="loader-mark" src="{{ 'velmont-logo-full@2x.png' | asset_url }}" alt="{{ shop.name }}" width="220" height="174">
    <div class="loader-rule"></div>
  </div>
</div>

{% section 'header' %}

<div class="menu" data-menu data-tone="dark">
  <button class="icon-btn menu__close" data-menu-close aria-label="Cerrar menú">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 5l14 14M19 5L5 19"/></svg>
  </button>
  <nav class="menu__list" data-menu-list>
    <a href="{{ routes.all_products_collection_url }}" data-visual="0"><span class="idx">01</span>Colección</a>
    <a href="{{ routes.root_url }}#descubre" data-finder-open data-visual="1"><span class="idx">02</span>Descubre tu firma</a>
    <a href="{{ routes.root_url }}#ediciones" data-visual="2"><span class="idx">03</span>Ediciones</a>
    <a href="{{ routes.root_url }}#casa" data-visual="3"><span class="idx">04</span>La casa</a>
    <a href="{{ routes.root_url }}#contacto" data-visual="4"><span class="idx">05</span>Contacto</a>
  </nav>
  <div class="menu__visual" data-menu-visual></div>
</div>

<main id="main-content">
  {{ content_for_layout }}
</main>

{% section 'footer' %}

{% comment %} Bolsa, guardados, buscador, asesor y finder los monta el JS. {% endcomment %}
<div data-bag-root></div>
<div data-saved-root></div>
<div data-search-root></div>
<div data-advisor-root></div>
<div data-finder-root></div>

<script type="application/json" id="velmont-catalog-data">
  {%- render 'catalog-json' -%}
</script>

<script type="module" src="{{ 'velmont-app.js' | asset_url }}"></script>
</body>
</html>
