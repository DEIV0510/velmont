<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#090909">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <title>{% if page_title != blank %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if template.name == 'product' and product.featured_image %}<meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    {% unless template.name == 'product' or template.name == 'search' %}
      <script type="application/ld+json">
        { "@context": "https://schema.org", "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | append: routes.root_url | json }} }
      </script>
    {% endunless %}
    {{ content_for_header }}
    <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{ 'velmont.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'velmont.js' | asset_url }}" defer="defer"></script>
    <script type="application/json" id="velmont-promo-data">{% render 'promo-data' %}</script>
  </head>
  <body class="template-{{ request.page_type | handle }}">
    <div data-loading-screen>
      <div class="loader-mark"><img src="{{ 'velmont-logo-header.png' | asset_url }}" width="220" height="175" alt="{{ shop.name }}"></div>
      <div class="loader-rule"></div>
    </div>
    <a class="skip-link" href="#MainContent">Ir al contenido</a>
    {% section 'velmont-announcement' %}
    {% section 'velmont-header' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'velmont-footer' %}
    {% render 'cart-drawer' %}
    {% render 'saved-drawer' %}
    {% render 'search-overlay' %}
    {% render 'whatsapp-float' %}
  </body>
</html>
