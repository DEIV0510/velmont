{%- comment -%}
  «¿Quieres trabajar con nosotros?» — seccion propia de la portada, justo
  antes de «Para terminar» (pedidos del dueño, 2026-10-06: primero la quiso
  en el pie y luego aqui). Un titular y un boton de WhatsApp que abre el chat
  con un mensaje ya escrito, para que el dueño sepa de donde llega la
  persona. El numero sale de Ajustes del tema → Marca: sin numero, o sin
  titular, la seccion no se pinta.
{%- endcomment -%}
{%- if settings.whatsapp != blank and section.settings.heading != blank -%}
  {%- liquid
    assign wa = settings.whatsapp | split: '?' | first
    if section.settings.message != blank
      assign mensaje = section.settings.message | url_encode | replace: '+', '%20'
      assign wa = wa | append: '?text=' | append: mensaje
    endif
  -%}
  <section {% render 'panel', color: section.settings.panel, extra: 'trabajo' %}>
    <div class="column trabajo__in">
      {%- if section.settings.index != blank -%}
        <span class="section-index" data-reveal>{{ section.settings.index }}</span>
      {%- endif -%}
      <h2 class="trabajo__t" data-reveal>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="trabajo__p" data-reveal>{{ section.settings.text }}</p>
      {%- endif -%}
      <a class="wa-btn" href="{{ wa }}" target="_blank" rel="noopener" data-reveal>
        <span class="wa-btn__ico">{% render 'icon', name: 'whatsapp', size: 24 %}</span>
        <span class="wa-btn__txt">
          <span class="wa-btn__t">WhatsApp</span>
          <span class="wa-btn__s">{{ section.settings.button | default: 'Comunícate a nuestro WhatsApp' }}</span>
        </span>
      </a>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Trabaja con nosotros",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "index", "label": "Índice" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "¿Quieres trabajar con nosotros?", "info": "Déjalo vacío para quitar la sección." },
    { "type": "textarea", "id": "text", "label": "Texto", "info": "Opcional. Va entre el titular y el botón." },
    { "type": "text", "id": "button", "label": "Texto del botón", "default": "Comunícate a nuestro WhatsApp" },
    { "type": "text", "id": "message", "label": "Mensaje con el que se abre el chat", "default": "Hola, quiero trabajar con VELMONT.", "info": "Así sabes que la persona llega desde aquí. El número sale de Ajustes del tema → Marca." },
    {
      "type": "select",
      "id": "panel",
      "label": "Panel",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "ink", "label": "Tinta" },
        { "value": "black", "label": "Negro" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Trabaja con nosotros" }]
}
{% endschema %}
