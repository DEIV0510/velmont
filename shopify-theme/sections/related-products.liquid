<section class="band band--tight" data-tone="light">
  <div class="wrap" style="margin-bottom:clamp(40px,5vw,72px)">
    <span class="section-index" data-reveal>{{ section.settings.title }}</span>
  </div>
  <div class="grid-quiet" data-related></div>
</section>

{% schema %}
{
  "name": "También podría gustarte",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "También podría gustarte" }
  ]
}
{% endschema %}
