<footer class="foot" id="contacto">
  <div class="foot__in">
    <div class="foot__mark"><img src="{{ 'velmont-wordmark.webp' | asset_url }}" alt="{{ shop.name }}" width="1550" height="343" loading="lazy"></div>
    <div class="foot__cols">
      <div>
        <h4 class="label">La casa</h4>
        <p class="fine">{{ section.settings.brand_copy }}</p>
      </div>
      <div>
        <h4 class="label">Explorar</h4>
        <ul>
          {%- for link in section.settings.nav_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      <div>
        <h4 class="label">Ayuda</h4>
        <ul>
          {%- for link in section.settings.help_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      <div>
        <h4 class="label">Contacto</h4>
        <ul>
          {%- if section.settings.whatsapp_url != blank -%}<li><a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
          {%- if section.settings.instagram_url != blank -%}<li><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
          {%- if section.settings.contact_email != blank -%}<li><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></li>{%- endif -%}
        </ul>
      </div>
    </div>
    <div class="foot__base">
      <span class="label">© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span class="label">{{ section.settings.place }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "brand_copy", "label": "Descripción", "default": "Perfumería seleccionada para quienes dejan una impresión. Envíos a toda Colombia." },
    { "type": "link_list", "id": "nav_menu", "label": "Menú explorar", "default": "footer" },
    { "type": "link_list", "id": "help_menu", "label": "Menú ayuda", "default": "footer" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp", "default": "https://wa.me/573103608872" },
    { "type": "url", "id": "instagram_url", "label": "Instagram", "default": "https://instagram.com/velmont.fragances" },
    { "type": "text", "id": "contact_email", "label": "Correo" },
    { "type": "text", "id": "place", "label": "Ciudad", "default": "Bogotá · Colombia" }
  ]
}
{% endschema %}
