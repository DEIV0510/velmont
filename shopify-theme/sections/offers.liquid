<section id="ediciones">
  <article class="campaign grain" data-tone="dark" data-campaign="matai">
    <div class="campaign__texture" aria-hidden="true"></div>
    <div class="campaign__in">
      <div>
        <span class="section-index" data-reveal>{{ section.settings.index_label }}</span>
        <h2 class="display campaign__title" data-reveal>
          <span class="line-mask"><span>{{ section.settings.matai_title }}</span></span>
        </h2>
        <p class="campaign__line lede" data-reveal style="--reveal-delay:180ms">{{ section.settings.matai_line }}</p>
        <p class="campaign__price" data-reveal style="--reveal-delay:260ms" data-promo-price="matai">
          {{ settings.matai_promo_units }} × {{ settings.matai_promo_price | times: 100 | money_without_trailing_zeros }}<sup>COP</sup>
        </p>
        <div class="campaign__cta" data-reveal style="--reveal-delay:340ms">
          <a href="{{ routes.all_products_collection_url }}?promo=matai" class="act">{{ section.settings.cta }}</a>
        </div>
      </div>
      <div class="campaign__duo" data-duo="matai" data-reveal="wipe"></div>
    </div>
  </article>

  <article class="campaign campaign--flip grain" data-tone="dark" data-campaign="seleccion">
    <div class="campaign__texture" aria-hidden="true"></div>
    <div class="campaign__in">
      <div>
        <span class="label label--gold" data-reveal>{{ section.settings.seleccion_label }}</span>
        <h2 class="display campaign__title" data-reveal>
          <span class="line-mask"><span>{{ section.settings.seleccion_title }}</span></span>
        </h2>
        <p class="campaign__line lede" data-reveal style="--reveal-delay:180ms">{{ section.settings.seleccion_line }}</p>
        <p class="campaign__price" data-reveal style="--reveal-delay:260ms" data-promo-price="seleccion">
          {{ settings.seleccion_promo_units }} × {{ settings.seleccion_promo_price | times: 100 | money_without_trailing_zeros }}<sup>COP</sup>
        </p>
        <div class="campaign__cta" data-reveal style="--reveal-delay:340ms">
          <a href="{{ routes.all_products_collection_url }}?promo=seleccion" class="act">{{ section.settings.cta }}</a>
        </div>
      </div>
      <div class="campaign__duo" data-duo="seleccion" data-reveal="wipe"></div>
    </div>
  </article>
</section>

{% schema %}
{
  "name": "Ediciones",
  "settings": [
    { "type": "text", "id": "index_label", "label": "Índice", "default": "04 — Ediciones" },
    { "type": "text", "id": "matai_title", "label": "Título MATAI", "default": "The MATAI Edit" },
    { "type": "textarea", "id": "matai_line", "label": "Bajada MATAI", "default": "Dos fragancias de la casa MATAI. Una sola firma." },
    { "type": "text", "id": "seleccion_label", "label": "Etiqueta Dúo", "default": "Edición" },
    { "type": "text", "id": "seleccion_title", "label": "Título Dúo", "default": "El Dúo VELMONT" },
    { "type": "textarea", "id": "seleccion_line", "label": "Bajada Dúo", "default": "Dos esencias participantes, elegidas por ti, a un mismo precio." },
    { "type": "text", "id": "cta", "label": "Botón", "default": "Elegir las dos" },
    { "type": "paragraph", "content": "Los precios y unidades salen de Configuración del tema → Promoción MATAI / Promoción Selección VELMONT." }
  ],
  "presets": [{ "name": "Ediciones" }]
}
{% endschema %}
