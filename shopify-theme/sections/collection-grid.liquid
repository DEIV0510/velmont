<section class="band band--tight" data-tone="light" style="padding-top:calc(var(--header-h) + clamp(48px,9vw,140px))">
  <div class="wrap">
    <span class="section-index" data-reveal>{{ section.settings.index_label }}</span>
    <h1 class="display" style="margin-top:28px;max-width:14ch" data-reveal>
      <span class="line-mask"><span>{{ section.settings.title }}</span></span>
    </h1>
    <p class="lede" style="margin-top:28px" data-reveal data-collection-note></p>
  </div>
</section>

<div class="filters" data-filters style="margin-bottom:clamp(40px,5vw,72px)"></div>

<section style="padding-bottom:var(--band)">
  <p class="lede wrap" data-empty hidden>No hay fragancias con esa combinación. Prueba con otra.</p>
  <div class="grid-quiet" data-grid></div>
</section>

{% schema %}
{
  "name": "Colección VELMONT",
  "settings": [
    { "type": "text", "id": "index_label", "label": "Índice", "default": "La colección" },
    { "type": "text", "id": "title", "label": "Título", "default": "Todas las piezas" }
  ],
  "presets": [{ "name": "Colección VELMONT" }]
}
{% endschema %}
