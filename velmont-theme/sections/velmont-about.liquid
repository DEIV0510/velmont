{%- liquid
  comment
    La escena de esta seccion es 3:2 (horizontal, de ambiente). NO se rellena
    con la foto de un producto: una foto 4:5 dentro de una caja 3:2 descarta
    el 36% de la imagen, que era el unico recorte destructivo vivo del tema.
    Sin escena, la seccion se maqueta a una sola columna y no deja hueco.
  endcomment
  assign figure_image = section.settings.image
-%}

<section {% render 'panel', color: section.settings.panel, extra: 'band world' %} id="{{ section.settings.anchor | default: 'casa' }}" data-parallax>
  <div class="world__in{% unless figure_image %} world__in--solo{% endunless %}">
    {%- if figure_image -%}
    <div class="world__figure" data-reveal="wipe">
        <img src="{{ figure_image | image_url: width: 1200 }}"
             srcset="{{ figure_image | image_url: width: 600 }} 600w, {{ figure_image | image_url: width: 1200 }} 1200w"
             sizes="(min-width: 900px) 40vw, 92vw"
             alt="{{ figure_image.alt | default: section.settings.heading | escape }}"
             width="{{ figure_image.width }}" height="{{ figure_image.height }}"
           loading="lazy">
    </div>
    {%- endif -%}

    <div>
      {%- if section.settings.index != blank -%}
        <span class="section-index" data-reveal>{{ section.settings.index }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2 world__title" data-reveal>
          {%- if section.settings.italic -%}<em>{{ section.settings.heading }}</em>{%- else -%}{{ section.settings.heading }}{%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="world__text fine" data-reveal>{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.link_text != blank -%}
        <div class="world__cta" data-reveal>
          <a href="{{ section.settings.link_url | default: routes.all_products_collection_url }}" class="link">{{ section.settings.link_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "La casa",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "index", "label": "Índice", "default": "05 — La casa" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "«Pocas piezas, elegidas una a una»." },
    { "type": "checkbox", "id": "italic", "label": "Titular en cursiva", "default": true },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>VELMONT no fabrica, elige. Trabajamos con casas como MATAI para traer a Colombia piezas de carácter propio, en cantidades cortas.</p>" },
    { "type": "text", "id": "link_text", "label": "Enlace", "default": "Conocer la colección" },
    { "type": "url", "id": "link_url", "label": "Destino del enlace" },
    {
      "type": "header",
      "content": "Visual"
    },
    { "type": "image_picker", "id": "image", "label": "Escena", "info": "Horizontal 3:2 (2400×1600). De ambiente, no de frasco: el producto ya tiene su sección." },
    {
      "type": "header",
      "content": "Opciones"
    },
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "casa" },
    {
      "type": "select",
      "id": "panel",
      "label": "Panel",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "black", "label": "Negro" },
        { "value": "ink", "label": "Tinta" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "La casa" }]
}
{% endschema %}
