{%- comment -%}
  Buscador a pantalla completa. Usa la busqueda predictiva de Shopify
  (/search/suggest.json): no se embebe el catalogo en el cliente, asi que
  funciona igual con 20 productos que con 2.000.
{%- endcomment -%}
<div class="search" data-search data-tone="dark" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'general.search.title' | t }}">
  <button class="icon-btn search__close" data-search-close aria-label="{{ 'accessibility.close' | t }}">
    {% render 'icon', name: 'close', size: 18 %}
  </button>

  <span class="label">{{ 'general.search.title' | t }}</span>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="VelmontSearch">{{ 'general.search.placeholder' | t }}</label>
    <input id="VelmontSearch"
           type="search"
           name="q"
           autocomplete="off"
           placeholder="{{ 'general.search.placeholder' | t }}"
           data-search-input>
  </form>

  <div class="search__out" data-search-out aria-live="polite"></div>
  <p class="label search__note" data-search-note></p>
</div>
