<section class="contact-page">
  <div class="page-width contact-page__grid">
    <div><p class="eyebrow">Customer service</p><h1>{{ page.title | default: 'Servicio al cliente' }}</h1><p>Escríbenos para recibir ayuda con una fragancia, un pedido o un regalo. Te responderemos desde el canal que configures para Velmont.</p>{% if settings.support_email != blank %}<a class="text-link" href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{% endif %}</div>
    {% form 'contact', class: 'contact-form' %}
      {% if form.posted_successfully? %}<p class="form-success">Gracias. Recibimos tu mensaje.</p>{% endif %}
      {{ form.errors | default_errors }}
      <label for="ContactName">Nombre</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name">
      <label for="ContactEmail">Correo electrónico</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required>
      <label for="ContactMessage">¿Cómo podemos ayudarte?</label><textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea>
      <button class="button button--gold" type="submit">Enviar mensaje</button>
    {% endform %}
  </div>
</section>

{% schema %}
{"name":"Formulario de contacto","settings":[]}
{% endschema %}
