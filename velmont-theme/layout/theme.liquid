<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_noir }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- liquid
    comment
      El nombre que ve el cliente lo manda el tema, no el ajuste de Shopify:
      la tienda se llama todavia "Mi tienda" y eso sale en el titulo de la
      portada, que es lo primero que indexa Google.

      - En la portada, Shopify usa el nombre de la tienda como page_title.
      - En el buscador mete el numero de resultados, que es una cifra de
        inventario y no vuelve a aparecer en la tienda.
      La comparacion va en minusculas para no repetir la marca cuando el
      titulo ya la trae con otra caja ("Velmont Fragrances").
    endcomment
    assign marca = settings.brand_name | default: shop.name
    assign titulo = page_title
    if request.page_type == "search"
      assign titulo = "general.search.title" | t
      if search.terms != blank
        assign titulo = titulo | append: ": " | append: search.terms
      endif
    endif
    if titulo == blank or titulo == shop.name
      assign titulo = marca
    endif

    comment
      198 fichas traen del catalogo de septiembre un titulo para Google
      «Nombre | Velmont Fragrances» y la descripcion «Compra X de Y en Velmont
      Fragrances.», con la marca mal escrita (revisado 2026-10-08). Sin tocar
      los productos: si el titulo trae «velmont fragrances» se usa el nombre
      del perfume (sale «NOMBRE · VELMONT», como en las fichas nuevas) y si la
      descripcion la trae, el comienzo de la descripcion real. La portada no
      tenia descripcion: va la frase de la casa (locales, general.meta_inicio).
    endcomment
    assign descripcion = page_description
    if request.page_type == "product"
      assign seo_cmp = titulo | downcase
      if seo_cmp contains "velmont fragrances"
        assign titulo = product.title
      endif
      assign seo_cmp = descripcion | downcase
      if seo_cmp contains "velmont fragrances" and product.description != blank
        assign descripcion = product.description | replace: "</p>", " " | strip_html | strip_newlines | strip | truncate: 160
      endif
    endif
    if request.page_type == "index" and descripcion == blank
      assign descripcion = "general.meta_inicio" | t
    endif
    assign descripcion = descripcion | replace: "Velmont Fragrances", marca

    assign titulo_cmp = titulo | downcase
    assign marca_cmp = marca | downcase
  -%}
  <title>{{ titulo }}{% unless titulo_cmp contains marca_cmp %} · {{ marca }}{% endunless %}</title>
  {% if descripcion != blank %}<meta name="description" content="{{ descripcion | escape }}">{% endif %}

  <meta property="og:site_name" content="{{ marca }}">
  <meta property="og:title" content="{{ titulo | escape }}">
  {% if descripcion != blank %}<meta property="og:description" content="{{ descripcion | escape }}">{% endif %}
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if request.page_type == 'product' and product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32">
  <link rel="icon" href="{{ 'favicon-192.png' | asset_url }}" sizes="192x192">
  <link rel="apple-touch-icon" href="{{ 'favicon-180.png' | asset_url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- comment -%}
    Letras de la casa (el dueño las eligio el 2026-10-07): Marcellus para
    titulos y Jost para textos. Fijas aqui y en velmont-tokens.css: antes las
    familias salian de los ajustes del tema, pero el CSS de tokens las pisaba
    y esos ajustes no mandaban.
  {%- endcomment -%}
  <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400..700;1,400..700&family=Marcellus&display=swap" rel="stylesheet">

  {%- assign marble = settings.texture_marble -%}

  {%- comment -%}
    Los tokens salen de los ajustes del tema, no del CSS: asi el cliente puede
    cambiarlos desde el editor. base.css solo consume variables.
  {%- endcomment -%}
  <style>
    :root{
      --noir: {{ settings.color_noir }};
      --noir-soft: {{ settings.color_noir_soft }};
      --ink: {{ settings.color_ink }};
      --ivory: {{ settings.color_ivory }};
      --bone: {{ settings.color_bone }};
      --sand: #DED7C7;
      --stone: {{ settings.color_stone }};
      --stone-deep: {{ settings.color_stone_deep }};

      --gold: {{ settings.color_gold }};
      --gold-light: {{ settings.color_gold_light }};
      --gold-deep: {{ settings.color_gold_deep }};
      --champagne: {{ settings.color_champagne }};

      --gold-line: linear-gradient(90deg, {{ settings.color_gold | color_modify: 'alpha', 0 }} 0%, var(--gold) 50%, {{ settings.color_gold | color_modify: 'alpha', 0 }} 100%);
      --gold-edge: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 45%, var(--gold-deep) 100%);

      --surface: var(--ivory);
      --surface-2: var(--bone);
      --on-surface: var(--ink);
      --on-surface-dim: var(--stone-deep);
      --hairline: {{ settings.color_ink | color_modify: 'alpha', 0.14 }};
      --hairline-strong: {{ settings.color_ink | color_modify: 'alpha', 0.28 }};

      --label-size: {{ settings.label_size }};
      --label-track: {{ settings.label_track }};

      --fs-mega: {{ settings.fs_mega }};
      --fs-display: {{ settings.fs_display }};
      --fs-h2: {{ settings.fs_h2 }};
      --fs-h3: {{ settings.fs_h3 }};
      --fs-lede: {{ settings.fs_lede }};
      --fs-body: 1rem;
      --fs-small: {{ settings.fs_small }};

      --band: {{ settings.space_band }};
      --band-tight: {{ settings.space_band_tight }};
      --gutter: {{ settings.space_gutter }};
      --measure: 62ch;

      --radius: {{ settings.border_radius }}px;
      --btn-pad: {{ settings.button_padding }};
      --btn-min-h: {{ settings.button_min_height }}px;
      --btn-weight: {{ settings.button_weight }};
      --shadow-bottle: {{ settings.shadow_bottle }};

      --t-fast: {{ settings.t_fast }}ms;
      --t-base: {{ settings.t_base }}ms;
      --t-slow: {{ settings.t_slow }}ms;
      --t-cine: {{ settings.t_cine }}ms;

      --header-h: {{ settings.header_height }}px;

      --img-marble: url({% if marble %}{{ marble | image_url: width: 1600 }}{% else %}{{ 'marble-dark.webp' | asset_url }}{% endif %});
    }
    [data-tone="dark"]{
      --hairline: {{ settings.color_ivory | color_modify: 'alpha', 0.16 }};
      --hairline-strong: {{ settings.color_ivory | color_modify: 'alpha', 0.34 }};
    }
  </style>

  {{ 'velmont-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'velmont-motion.css' | asset_url | stylesheet_tag }}

  {%- comment -%}
    .js-motion se pone de forma sincrona, antes de pintar: es lo que oculta los
    elementos que luego se revelan. Si se pusiera despues, se verian un
    instante y despues desaparecerian. Sin JS no se oculta nada.
  {%- endcomment -%}
  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-motion');
    }
  </script>

  <script>
    window.VELMONT = {
      shop: {{ shop.permanent_domain | json }},
      rootUrl: {{ routes.root_url | json }},
      // Proveedores que no son una casa: el que Shopify pone por defecto (el
      // nombre de la tienda) y la propia marca. No se enseñan como casa.
      sinCasa: [{{ shop.name | json }}, {{ settings.brand_name | json }}, "Mi tienda"],
      routes: {
        cart_add: '{{ routes.cart_add_url }}',
        cart_change: '{{ routes.cart_change_url }}',
        cart: '{{ routes.cart_url }}',
        predictive: '{{ routes.predictive_search_url }}',
        search: '{{ routes.search_url }}',
        root: '{{ routes.root_url }}'
      },
      // URLs con ?v=: un import relativo se sirve SIN esa query y el CDN puede
      // devolver una copia vieja aunque el push haya subido el archivo nuevo.
      assets: {
        carousel: '{{ 'carousel.js' | asset_url }}',
        quiz: '{{ 'quiz.js' | asset_url }}'
      },
      motion: {
        cursor: {{ settings.enable_cursor | json }},
        parallax: {{ settings.enable_parallax | json }},
        loader: {{ settings.enable_loader | json }}
      },
      strings: {
        added: {{ 'general.cart.added' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        empty: {{ 'general.cart.empty' | t | json }}
      }
    };
  </script>

  {%- comment -%}
    Librerias de movimiento como assets del tema, no por CDN: una conexion
    menos y ninguna dependencia de terceros. defer no bloquea el pintado y
    garantiza que gsap/ScrollTrigger/Lenis existan antes que el modulo.
  {%- endcomment -%}
  <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
  <script src="{{ 'scrolltrigger.min.js' | asset_url }}" defer></script>
  <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>

  <script src="{{ 'velmont-motion.js' | asset_url }}" type="module"></script>
  <script src="{{ 'global.js' | asset_url }}" type="module"></script>

  {{ content_for_header }}
</head>

{%- liquid
    assign light_pages = 'collection,search,page,list-collections,product,cart'
    assign is_light = false
    if light_pages contains request.page_type
      assign is_light = true
    endif
  -%}
  <body class="template-{{ request.page_type | handle }}"
        data-page="{{ request.page_type | handle }}"
        {% if is_light %}data-hdr="light"{% endif %}>

  {%- if settings.enable_loader -%}
    {%- comment -%}
      El logotipo completo (sello + VELMONT + FRAGANCES), no la marca escrita
      en tipografia: la pantalla de carga es el unico momento en que se enseña
      la marca entera y sin nada al lado.

      Sin opacity:0 esperando a JS. La entrada es una animacion de CSS pura,
      asi que si el JS no corre —o alguien captura antes— el logo igual esta
      ahi. Ya paso una vez: se veia un rectangulo negro vacio.
    {%- endcomment -%}
    <div data-loading-screen>
      <div class="loader__in">
        {%- if settings.logo_loader -%}
          <img class="loader__logo"
               src="{{ settings.logo_loader | image_url: width: 760 }}"
               srcset="{{ settings.logo_loader | image_url: width: 380 }} 380w, {{ settings.logo_loader | image_url: width: 760 }} 760w"
               sizes="(max-width: 760px) 62vw, min(30vw, 340px)"
               alt="{{ settings.brand_name | default: shop.name | escape }}"
               width="{{ settings.logo_loader.width }}" height="{{ settings.logo_loader.height }}"
               fetchpriority="high" decoding="sync">
        {%- else -%}
          <img class="loader__logo"
               src="{{ 'velmont-logo-full.png' | asset_url }}"
               alt="{{ settings.brand_name | default: shop.name | escape }}"
               width="1400" height="1107"
               fetchpriority="high" decoding="sync">
        {%- endif -%}
        <div class="loader-line" aria-hidden="true"></div>
      </div>
    </div>
  {%- endif -%}

  <a class="visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {%- comment -%}
    Una seccion que no pinta nada (la banda o los momentos sin imagen) deja su
    envoltorio vacio en medio y la regla de paneles contiguos del mismo color
    no veia a los vecinos: entre la Declaracion y «La casa» quedaban 210px de
    crema vacia (320 en escritorio; el dueño lo señalo el 2026-10-06). Se
    quitan antes de pintar, salvo en el editor, que necesita el envoltorio.
  {%- endcomment -%}
  {%- unless request.design_mode -%}
    <script>
      document.querySelectorAll('#MainContent > .shopify-section').forEach(function (s) {
        if (!s.firstElementChild && !s.textContent.trim()) s.remove();
      });
    </script>
  {%- endunless -%}

  {% sections 'footer-group' %}

  {% render 'wa-flotante' %}

  {% render 'bag-drawer' %}
  {% render 'saved-drawer' %}
  {% render 'search-overlay' %}
  {% render 'quiz' %}

  <div class="scrim" data-scrim></div>
</body>
</html>
