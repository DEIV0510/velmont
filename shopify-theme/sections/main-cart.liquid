<!-- Pagina nativa /cart de Shopify: solo se ve si alguien navega ahi
     directamente (o sin JS). La experiencia principal es la bolsa lateral
     (cart-ui.js) sobre la Cart AJAX API; esta es el respaldo, con el mismo
     sistema de diseño del resto del sitio en vez de clases que no existian
     en components.css. -->
<section class="band band--tight" data-tone="light">
  <div class="wrap" style="max-width:760px">
    <span class="section-index" data-reveal>Tu selección</span>
    <h1 class="display" style="margin-top:24px;margin-bottom:clamp(40px,5vw,72px)" data-reveal>VELMONT</h1>

    {%- if cart.item_count == 0 -%}
      <p class="lede">Tu bolsa está vacía.</p>
      <p style="margin-top:32px"><a href="{{ routes.all_products_collection_url }}" class="act">Ver la colección</a></p>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="display:grid;gap:0">
          {%- for item in cart.items -%}
            <div class="bag-line">
              <div>
                {%- if item.image -%}
                  {{ item.image | image_url: width: 128 | image_tag: loading: 'lazy', alt: item.product.title }}
                {%- endif -%}
              </div>
              <div>
                <p class="bag-line__name">{{ item.product.title }}</p>
                <span class="label">{{ item.variant.title | replace: 'Default Title', '' }}</span>
                <div class="stepper" style="margin-top:var(--s3)">
                  <label class="label" for="qty-{{ item.key }}" style="margin-right:var(--s3)">Cantidad</label>
                  <input id="qty-{{ item.key }}" type="number" min="0" name="updates[{{ item.key }}]" value="{{ item.quantity }}" style="width:52px;text-align:center;border:1px solid var(--hairline);background:transparent;color:var(--on-surface);padding:6px 0">
                </div>
              </div>
              <div class="bag-line__right">
                <span class="price">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <p class="fine" style="margin-top:var(--s6)">Las ediciones MATAI y Selección VELMONT se calculan y muestran en la bolsa lateral (ícono de la bolsa, arriba). Actualiza cantidades aquí y ábrela de nuevo para ver el precio con la promoción aplicada.</p>

        <div class="bag-totals" style="margin-top:var(--s6);padding-top:var(--s5);border-top:1px solid var(--hairline)">
          <span class="label">Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>

        <div style="display:flex;gap:var(--s5);flex-wrap:wrap;margin-top:var(--s6)">
          <button type="submit" name="update" class="act">Actualizar</button>
          <a href="{{ routes.cart_url }}/checkout" class="act act--solid">Finalizar compra</a>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrito"
}
{% endschema %}
