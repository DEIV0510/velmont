<section class="section" data-surface="light" style="padding-top:0">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="h-section" data-reveal>{{ section.settings.title }}</h2>
    </div>
    <div class="product-grid" data-cross-sell></div>
  </div>
</section>

{% schema %}
{
  "name": "También podría gustarte",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Cross-selling" },
    { "type": "text", "id": "title", "label": "Título", "default": "También podría gustarte" }
  ]
}
{% endschema %}
