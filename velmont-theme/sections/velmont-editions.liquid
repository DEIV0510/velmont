{%- comment -%}
  04 — Ediciones. Cada bloque es una campaña a pantalla: texto a un lado y el
  dúo de frascos al otro, con la textura enmascarada en dirección contraria.

  El precio NO se escribe a mano: sale de la regla real (unidades × precio) y
  se renderiza con el filtro money, para que cambie solo si cambia el precio.
{%- endcomment -%}

{%- if section.settings.layout == 'cards' -%}
  {%- comment -%}
    Tarjetas lado a lado, como en la maqueta del cliente: la oferta se tiene
    que entender sin bajar dos pantallas de paneles. «Por separado» NO se
    escribe a mano: solo sale cuando TODA la coleccion comparte precio (MATAI,
    13 a 290.000) y es ese precio por las unidades. Con precios mezclados
    (el duo: de 110.000 a 170.000) no hay un «antes» honesto, y no se pinta.
  {%- endcomment -%}
  <section {% render 'panel', color: section.settings.panel, extra: 'band band--tight ediciones' %} id="{{ section.settings.anchor | default: 'promociones' }}">
    {% render 'section-header', index: section.settings.index, title: section.settings.heading, lede: section.settings.lede %}
    <div class="ediciones__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign source = block.settings.collection
          assign precio = block.settings.promo_price | times: 100
          assign antes = 0
          if source != blank and block.settings.promo_price > 0
            assign minimo = 0
            assign maximo = 0
            for p in source.products limit: 50
              if forloop.first
                assign minimo = p.price
                assign maximo = p.price
              endif
              if p.price < minimo
                assign minimo = p.price
              endif
              if p.price > maximo
                assign maximo = p.price
              endif
            endfor
            if minimo == maximo and minimo > 0
              assign antes = minimo | times: block.settings.promo_units
            endif
          endif
          assign destino = block.settings.cta_url | default: source.url | default: routes.all_products_collection_url
        -%}
        <article class="edicion grain" data-reveal {{ block.shopify_attributes }}>
          <div class="edicion__txt">
            {%- if block.settings.index != blank -%}
              <span class="label label--gold">{{ block.settings.index }}</span>
            {%- endif -%}
            <h3 class="edicion__titulo">{{ block.settings.heading }}</h3>
            {%- if block.settings.promo_price > 0 -%}
              <p class="edicion__precio">{{ block.settings.promo_units }} por {{ precio | money_without_trailing_zeros }}</p>
              {%- if antes > precio -%}
                <p class="edicion__antes">Por separado <s>{{ antes | money_without_trailing_zeros }}</s></p>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="edicion__texto">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <a href="{{ destino }}" class="act act--solid edicion__cta">{{ block.settings.cta_label }}</a>
            {%- endif -%}
          </div>
          <div class="edicion__duo" aria-hidden="true">
            {%- if source != blank -%}
              {%- for product in source.products limit: 2 -%}
                <img src="{{ product.featured_image | image_url: width: 400 }}"
                     srcset="{{ product.featured_image | image_url: width: 200 }} 200w, {{ product.featured_image | image_url: width: 400 }} 400w"
                     sizes="(min-width: 900px) 11vw, 40vw"
                     alt="" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
                     loading="lazy">
              {%- endfor -%}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>
{%- else -%}
<section id="{{ section.settings.anchor | default: 'promociones' }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign source = block.settings.collection
      assign flip = false
      if forloop.index0 == 1 or block.settings.flip
        assign flip = true
      endif
    -%}

    <article {% render 'panel', color: block.settings.panel, extra: 'campaign grain' %}{% if flip %} data-flip{% endif %} {{ block.shopify_attributes }}>
      <div class="campaign__texture" aria-hidden="true"></div>
      <div class="campaign__in">
        <div>
          {%- if block.settings.index != blank -%}
            <span class="{% if block.settings.index_gold %}label label--gold{% else %}section-index{% endif %}" data-reveal>{{ block.settings.index }}</span>
          {%- endif -%}

          <h2 class="display campaign__title" data-reveal>
            <span class="line-mask"><span>{{ block.settings.heading }}</span></span>
          </h2>

          {%- if block.settings.text != blank -%}
            <p class="campaign__line lede" data-reveal>{{ block.settings.text }}</p>
          {%- endif -%}

          {%- if block.settings.promo_price > 0 -%}
            <p class="campaign__price" data-reveal>
              {{ block.settings.promo_units }} &times; {{ block.settings.promo_price | times: 100 | money_without_trailing_zeros }}<sup>{{ cart.currency.iso_code }}</sup>
            </p>
          {%- endif -%}

          {%- if block.settings.cta_label != blank -%}
            <div class="campaign__cta" data-reveal>
              {%- comment -%}
                Destino propio si lo hay. Hace falta porque el dúo VELMONT ya
                no se arma en la coleccion: se arma en la ficha del combo, que
                es donde estan los dos desplegables. Mandar al cliente a la
                coleccion era mandarlo a que anadiera perfumes sueltos y no le
                aplicara nada.
              {%- endcomment -%}
              <a href="{{ block.settings.cta_url | default: source.url | default: routes.all_products_collection_url }}" class="act">{{ block.settings.cta_label }}</a>
            </div>
          {%- endif -%}
        </div>

        <div class="campaign__duo" data-reveal="wipe">
          {%- if source != blank -%}
            {%- for product in source.products limit: 2 -%}
              <figure>
                <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  <img src="{{ product.featured_image | image_url: width: 600 }}"
                       srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                       sizes="clamp(110px, 16vw, 210px)"
                       alt="{{ product.featured_image.alt | default: product.title | escape }}"
                       width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
                       loading="lazy">
                </a>
              </figure>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </article>
  {%- endfor -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Promociones",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición",
      "options": [
        { "value": "panels", "label": "Una campaña por pantalla" },
        { "value": "cards", "label": "Tarjetas lado a lado" }
      ],
      "default": "panels",
      "info": "Tarjetas: las ofertas se entienden de un vistazo, justo después de la portada."
    },
    {
      "type": "header",
      "content": "Encabezado (solo en tarjetas)"
    },
    { "type": "text", "id": "index", "label": "Índice", "default": "Promociones" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Promociones especiales" },
    { "type": "text", "id": "lede", "label": "Frase bajo el titular", "default": "Elige dos y paga un precio fijo por la pareja." },
    {
      "type": "select",
      "id": "panel",
      "label": "Panel",
      "options": [
        { "value": "black", "label": "Negro" },
        { "value": "ink", "label": "Tinta" },
        { "value": "cream", "label": "Crema" }
      ],
      "default": "ink"
    },
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "promociones" }
  ],
  "blocks": [
    {
      "type": "edition",
      "name": "Promoción",
      "settings": [
        { "type": "text", "id": "index", "label": "Índice o etiqueta", "default": "Promoción" },
        { "type": "checkbox", "id": "index_gold", "label": "Mostrarlo como etiqueta dorada", "default": false },
        { "type": "text", "id": "heading", "label": "Titular", "default": "La selección MATAI" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Dos fragancias de la casa MATAI, elegidas para ir juntas." },
        { "type": "collection", "id": "collection", "label": "Colección participante", "info": "De aquí salen las dos fotos y el destino del botón." },
        {
          "type": "header",
          "content": "Precio de la promoción"
        },
        { "type": "paragraph", "content": "Esto es solo el anuncio. El descuento real se configura en Descuentos → Descuento automático, y es el que se aplica en la bolsa y en el pago." },
        { "type": "range", "id": "promo_units", "label": "Unidades", "min": 2, "max": 6, "step": 1, "default": 2 },
        { "type": "number", "id": "promo_price", "label": "Precio total", "default": 450000 },
        { "type": "text", "id": "cta_label", "label": "Botón", "default": "Elegir las dos" },
        { "type": "url", "id": "cta_url", "label": "Destino del botón", "info": "Si la promoción se arma en una ficha de combo, apunta aquí a ese producto. Vacío, lleva a la colección." },
        { "type": "checkbox", "id": "flip", "label": "Invertir la composición", "default": false },
        {
          "type": "select",
          "id": "panel",
          "label": "Panel",
          "options": [
            { "value": "black", "label": "Negro" },
            { "value": "ink", "label": "Tinta" },
            { "value": "cream", "label": "Crema" }
          ],
          "default": "ink"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Promociones",
      "blocks": [
        { "type": "edition" },
        {
          "type": "edition",
          "settings": {
            "index": "Promoción",
            "index_gold": true,
            "heading": "El dúo VELMONT",
            "text": "Dos esencias de la promoción, elegidas por ti, al mismo precio.",
            "promo_price": 280000,
            "flip": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
