<header class="hdr" data-hdr>
  <div class="hdr__in">
    <nav class="hdr__nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <a href="{{ routes.root_url }}" class="hdr__mark">
      <img src="{{ 'velmont-wordmark.png' | asset_url }}" alt="{{ shop.name }}" width="240" height="53" loading="eager">
    </a>
    <div class="hdr__acts">
      <button class="icon-btn" data-search-open aria-label="Buscar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button class="icon-btn" data-fav-open aria-label="Guardados">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 20s-7-4.4-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.6-9.5 9-9.5 9Z"/></svg>
        <span class="count off" data-fav-count>0</span>
      </button>
      <button class="icon-btn" data-bag-open aria-label="Bolsa">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 7h12l1 14H5z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="count off" data-bag-count>{{ cart.item_count }}</span>
      </button>
      <button class="icon-btn burger" data-menu-open aria-label="Menú" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú de navegación", "default": "main-menu" }
  ]
}
{% endschema %}
