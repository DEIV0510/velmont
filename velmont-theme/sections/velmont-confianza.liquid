{%- comment -%}
  Fila de garantías (pedido del dueño, 2026-10-09, con Disfragancias de
  referencia: «añadir cosas así me gusta»). Cuatro cajas con ícono y una
  frase. Solo promesas que la tienda cumple hoy: perfumes originales, pago
  con Bold o contra entrega, envío gratis a todo Colombia y asesoría por
  WhatsApp. Nada de «devoluciones fáciles» mientras no exista esa política.
  Un bloque con enlace vacío y el ícono de asesoría abre el WhatsApp de
  Ajustes del tema → Marca.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section {% render 'panel', color: section.settings.panel, extra: 'confianza' %}>
    <div class="column">
      {%- if section.settings.heading != blank -%}
        <h2 class="confianza__t" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <ul class="confianza__fila" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign enlace = block.settings.link
            if enlace == blank and block.settings.icon == 'chat' and settings.whatsapp != blank
              assign enlace = settings.whatsapp
            endif
          -%}
          <li class="confianza__item" data-reveal {{ block.shopify_attributes }}>
            {%- if enlace != blank -%}<a class="confianza__in" href="{{ enlace }}"{% if enlace contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>{%- else -%}<div class="confianza__in">{%- endif -%}
              <span class="confianza__ico">{% render 'icon', name: block.settings.icon, size: 30 %}</span>
              <span class="confianza__titulo">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}<span class="confianza__texto">{{ block.settings.text }}</span>{%- endif -%}
            {%- if enlace != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Garantías",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular", "info": "Opcional." },
    {
      "type": "select",
      "id": "panel",
      "label": "Panel",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "ink", "label": "Tinta" },
        { "value": "black", "label": "Negro" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "original", "label": "Escudo (originales)" },
            { "value": "pago", "label": "Tarjeta (pago)" },
            { "value": "envio", "label": "Camión (envío)" },
            { "value": "chat", "label": "Globo (asesoría)" }
          ],
          "default": "original"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Perfumes 100 % originales" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Opcional. Con el ícono de asesoría y sin enlace, abre el WhatsApp de la marca." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Garantías" }]
}
{% endschema %}
