<section class="service" aria-labelledby="ServiceTitle">
  <div class="page-width">
    <div class="section-heading service__heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 id="ServiceTitle">{{ section.settings.heading }}</h2></div><p>{{ section.settings.text }}</p></div>
    <div class="service__cards">
      <div><span>01</span><h3>Elige sin prisa</h3><p>Usa el Código de Aroma y recorre las familias de fragancias con una guía clara.</p></div>
      <div><span>02</span><h3>Pregunta a Velmont</h3><p>Te ayudamos a elegir para ti, regalar o encontrar una alternativa que encaje con tu estilo.</p></div>
      <div><span>03</span><h3>Compra con claridad</h3><p>Consulta disponibilidad, métodos de envío y seguimiento antes de confirmar tu pedido.</p></div>
    </div>
    <div class="service__actions">
      <a class="button button--gold" href="/pages/contact">Servicio al cliente</a>
      {% if settings.whatsapp_url != blank %}<a class="text-link" href="{{ settings.whatsapp_url }}" target="_blank" rel="noopener">Hablar por WhatsApp <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Servicio al cliente",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Customer service, a tu manera"},
    {"type":"textarea","id":"heading","label":"Título","default":"El lujo también es\nsentirse acompañado."},
    {"type":"textarea","id":"text","label":"Texto","default":"Una atención sencilla, humana y directa desde el primer descubrimiento hasta que tu pedido llega a ti."}
  ]
}
{% endschema %}
