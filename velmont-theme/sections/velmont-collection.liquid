{%- comment -%}
  02 — La colección. En escritorio es una composición asimétrica de 12
  columnas (no una cuadrícula pareja); en ≤859 px se convierte en una galería
  deslizable con indicador 01 / 06. Las piezas salen de una colección real.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.count
  if section.settings.rotate and source == blank
    assign source = collections.all
  endif
  if section.settings.layout == 'pinned'
    assign tam = '(min-width: 900px) 24vw, 76vw'
  else
    assign tam = '(min-width: 1200px) 20vw, (min-width: 860px) 27vw, 76vw'
  endif
-%}

{%- capture piezas -%}
  {%- if section.settings.rotate -%}
    {%- comment -%}
      Rotacion. El cliente: «parece que solo vendemos MATAI, siempre aparece
      MATAI». Se pinta una bolsa de ~4 veces las piezas a mostrar, repartida
      por TODO el catalogo (una de cada `salto`, con un punto de arranque que
      cambia cada dia), y el script de abajo elige al azar, en el navegador,
      las que se ven, sin repetir casa. Tiene que ser en el navegador: Shopify
      guarda la portada en cache y un azar hecho aqui se repetiria para todos.
      Fuera: agotados, sin foto, lo que no es de una casa (el combo tiene de
      casa el nombre de la tienda) y los productos excluidos a mano.
    {%- endcomment -%}
    {%- liquid
      assign excluidos = '|'
      for x in section.settings.exclude
        assign excluidos = excluidos | append: x.handle | append: '|'
      endfor
      assign bolsa = limit | times: 4
      assign salto = source.products_count | divided_by: bolsa | at_least: 1
      assign inicio = 'now' | date: '%j' | modulo: salto
      assign tomadas = 0
    -%}
    {%- paginate source.products by 250 -%}
      {%- for p in source.products -%}
        {%- liquid
          assign marca = '|' | append: p.handle | append: '|'
          assign vale = true
          if p.available == false or p.featured_image == blank or p.vendor == blank or p.vendor == shop.name
            assign vale = false
          endif
          if excluidos contains marca
            assign vale = false
          endif
          assign turno = forloop.index0 | modulo: salto
        -%}
        {%- if vale and turno == inicio -%}
          {% render 'piece', product: p, sizes: tam %}
          {%- assign tomadas = tomadas | plus: 1 -%}
          {%- if tomadas >= bolsa -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- for product in source.products limit: limit -%}
      {% render 'piece', product: product, eager: forloop.first, sizes: tam %}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture rotar -%}
  {%- if section.settings.rotate -%}
    <script>
      /* Elige al azar {{ limit }} piezas de la bolsa, sin repetir casa, y
         QUITA el resto del documento: esconderlas no basta, las reglas
         nth-child de la rejilla cuentan hijos. Va en linea y sin defer: corre
         mientras se analiza la pagina, antes de que el carrusel y las
         animaciones cuenten las piezas. */
      (function () {
        var caja = document.currentScript.previousElementSibling;
        if (!caja) return;
        var n = {{ limit }};
        var piezas = Array.prototype.slice.call(caja.children);
        for (var i = piezas.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var t = piezas[i]; piezas[i] = piezas[j]; piezas[j] = t;
        }
        var casas = {}, elegidas = [], resto = [];
        piezas.forEach(function (p) {
          var c = p.getAttribute('data-casa') || '';
          if (elegidas.length < n && !casas[c]) { casas[c] = true; elegidas.push(p); } else { resto.push(p); }
        });
        while (elegidas.length < n && resto.length) elegidas.push(resto.shift());
        piezas.forEach(function (p) { if (elegidas.indexOf(p) < 0) p.remove(); });
        elegidas.forEach(function (p) { caja.appendChild(p); });
        caja.removeAttribute('data-rotar');
      })();
    </script>
  {%- endif -%}
{%- endcapture -%}

{%- if section.settings.rotate -%}
  {%- comment -%} Sin JS, o hasta que corre el script: solo las primeras {{ limit }}. {%- endcomment -%}
  <style>[data-rotar] > :nth-child(n + {{ limit | plus: 1 }}) { display: none; }</style>
{%- endif -%}

<section {% render 'panel', color: section.settings.panel, extra: 'band band--tight' %} id="{{ section.settings.anchor | default: 'coleccion' }}"{% if section.settings.layout == "pinned" %} data-pin-h{% endif %}>
  {% render 'section-header',
     index: section.settings.index,
     title: section.settings.heading,
     lede: section.settings.lede,
     link_text: section.settings.link_text,
     link_url: source.url %}

  {%- if source != blank and source.products_count > 0 -%}
    {%- if section.settings.layout == "pinned" -%}
      {%- comment -%}
        Cinta anclada: la pagina se queda quieta y el catalogo avanza de lado.
        En movil el JS no la engancha y queda como carrusel de arrastre, que
        es el gesto natural ahi.
      {%- endcomment -%}
      <div class="pin-h__track" data-pin-track data-composition{% if section.settings.rotate %} data-rotar{% endif %} data-cursor-label="{{ 'motion.cursor.swipe' | t }}">{{ piezas }}</div>
      {{- rotar -}}
    {%- else -%}
      <div class="composition composition--{{ section.settings.layout }}" data-composition{% if section.settings.rotate %} data-rotar{% endif %}>{{ piezas }}</div>
      {{- rotar -}}
    {%- endif -%}

    <div class="swipe-hint" data-swipe-hint aria-hidden="true">
      <span class="label" data-swipe-count>01 / {{ source.products.size | at_most: limit | prepend: '0' | slice: -2, 2 }}</span>
      <i><b></b></i>
      <span class="label">{{ section.settings.swipe_label }}</span>
    </div>
  {%- else -%}
    <div class="wrap">
      <p class="lede">{{ 'sections.collection.empty' | t }}</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Colección",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "index", "label": "Índice", "default": "02 — La colección" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Nuestra selección" },
    { "type": "text", "id": "lede", "label": "Frase bajo el titular", "default": "Perfumes elegidos por VELMONT." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "checkbox", "id": "rotate", "label": "Perfumes al azar, uno por casa", "default": false, "info": "Cada visita muestra otros perfumes, sin repetir casa, para que la portada no parezca de una sola marca. Sin colección elegida, salen de todo el catálogo." },
    { "type": "product_list", "id": "exclude", "label": "Nunca mostrar en la rotación", "limit": 12, "info": "Por ejemplo, el producto del combo: no es un perfume." },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición",
      "options": [
        { "value": "even", "label": "Rejilla ordenada" },
        { "value": "broken", "label": "Rejilla rota (editorial)" },
        { "value": "editorial", "label": "Composición asimétrica" },
        { "value": "pinned", "label": "Cinta horizontal anclada" }
      ],
      "default": "broken",
      "info": "La rota es asimétrica pero ningún bloque pasa de 4 columnas de 12: no ocupa más alto que la ordenada. La asimétrica original se diseñó para ilustraciones con mucho aire y con fotos reales resulta enorme."
    },
    { "type": "range", "id": "count", "label": "Piezas a mostrar", "min": 3, "max": 12, "step": 1, "default": 6, "info": "La composición asimétrica está pensada para 6." },
    { "type": "text", "id": "link_text", "label": "Enlace", "default": "Ver todo el catálogo" },
    { "type": "text", "id": "swipe_label", "label": "Texto del indicador (móvil)", "default": "Desliza" },
    {
      "type": "header",
      "content": "Opciones"
    },
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "coleccion" },
    {
      "type": "select",
      "id": "panel",
      "label": "Panel",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "black", "label": "Negro" },
        { "value": "ink", "label": "Tinta" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Colección" }]
}
{% endschema %}
