<article class="product-card" data-vendor="{{ product.vendor | escape }}">
  <a class="product-card__image" href="{{ product.url }}" aria-label="Ver {{ product.title | escape }}">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product.featured_image.alt | default: product.title }}
    {% else %}
      <span class="product-card__monogram" aria-hidden="true">V</span>
      <span class="product-card__ornament" aria-hidden="true"></span>
    {% endif %}
    {% if product.compare_at_price > product.price %}<span class="product-card__badge">Oferta</span>{% endif %}
  </a>
  <button class="product-card__save" type="button" data-save="{{ product.id }}" aria-label="Guardar {{ product.title | escape }}" aria-pressed="false">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-7-4.4-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.6-9.5 9-9.5 9Z"/></svg>
  </button>
  {% if product.available %}
    <div class="product-card__quick">
      <span>{{ product.selected_or_first_available_variant.title | default: 'Añadir' }}</span>
      <button type="button" data-quick-add="{{ product.selected_or_first_available_variant.id }}">Añadir a la bolsa</button>
    </div>
  {% endif %}
  <div class="product-card__content">
    <p class="eyebrow">{{ product.vendor }}</p>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price">
      <span>{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
    </div>
  </div>
</article>
